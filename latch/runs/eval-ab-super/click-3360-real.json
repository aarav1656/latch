    "name": "test_help_formatter_write_usage_prints_usage_line_without_args",
    "source": "import pytest\n\ndef test_help_formatter_write_usage_prints_usage_line_without_args():\n    import click\n\n    # Issue: write_usage with no args used to emit only a blank line.\n    f = click.HelpFormatter()\n    f.write_usage(\"program\")\n    assert f.getvalue() == \"Usage: program\\n\"\n\n    # A caller-supplied prefix is preserved when there are no args.\n    f = click.HelpFormatter()\n    f.write_usage(\"program\", prefix=\"Run: \")\n    assert f.getvalue() == \"Run: program\\n\"\n\n    # When args are provided, the separator space is still emitted.\n    f = click.HelpFormatter()\n    f.write_usage(\"program\", \"[OPTIONS]\")\n    assert f.getvalue() == \"Usage: program [OPTIONS]\\n\"\n",
