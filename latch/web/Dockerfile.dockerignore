# Build context is the repository root:  docker build -f latch/web/Dockerfile .
**
!latch/*.py
!latch/harness/*.py
!latch/loop/**
!latch/web/**
!latch/runs/click-3298.json
!latch/runs/loop-demo-events.jsonl
!latch/runs/eval-summary.json
!latch/runs/eval/**
!latch/runs/eval-summary-repair.json
!latch/runs/eval-diff-repair.json
!latch/runs/eval-repair/**
# development-only and answer-key output never ships (the whitelist above does not admit them; this makes it explicit)
latch/runs/dev
latch/runs/dev/**
latch/runs/eval-dryrun
latch/runs/eval-dryrun/**
latch/runs/eval-oracle-baseline.*
latch/test_*.py
latch/harness/test_*.py
latch/loop/test_*.py
latch/web/test_*.py
latch/web/.data
latch/web/deploy.sh
**/__pycache__
**/*.pyc
# belt and braces: the whitelist above admits all of latch/web/**, so keep stray secrets out of it
**/.env
**/.env.*
**/account.json
**/*.pem
**/*.key
**/*token*
**/.config
# the design tokens file is not a secret; re-include it after the *token* rule
!latch/web/static/tokens.css
